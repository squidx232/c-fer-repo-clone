<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(ProbeWindows)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(ProbeWindows)' == 'true'">net8.0-windows</TargetFramework>
    <UseWPF Condition="'$(ProbeWindows)' == 'true'">true</UseWPF>
    <EnableWindowsTargeting Condition="'$(ProbeWindows)' == 'true'">true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="4.7.1" />
  </ItemGroup>
</Project>
